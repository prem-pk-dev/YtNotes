{
  "manifest_version": 3,
  "name": "YT Study Notes Pro",
  "version": "1.0.0",
  "description": "Take timestamped study notes on YouTube videos.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.lemonsqueezy.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Study Notes Pro"
  }
}
